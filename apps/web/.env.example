# Copy this file to .env.local and set the password.
#
# The database is Postgres + PostGIS in the container `demetra-db` (127.0.0.1:5433). The data
# pipeline makes it. The password is POSTGRES_PASSWORD in the `db/.env` file of the pipeline.
#
# A Neon connection string is a valid value too (NEON_DATABASE_URL in `db/.env.neon` of the
# pipeline).
DATABASE_URL=postgresql://cropland:<password>@127.0.0.1:5433/cropland

# The key of the Claude API for the chat assistant (`POST /api/chat`). Server code only: do not
# give it a NEXT_PUBLIC_ name. Without it, the chat answers with status 503.
ANTHROPIC_API_KEY=
